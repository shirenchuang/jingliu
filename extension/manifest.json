{
  "manifest_version": 3,
  "name": "静流 Jingliu — Jev 语义过滤器",
  "version": "0.5.0",
  "description": "用你的规则和 Jev 折叠 X 上的广告、低价值内容与不想看的主题。",
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.typesafe.ai/*",
    "https://openrouter.ai/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "静流 Jingliu",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "css": ["content/x.css"],
      "js": ["shared.js", "core.js", "content/x.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
